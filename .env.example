# Copy to .env and edit. All keys use WEB2PS5_ prefix.

# fake (default) | pyremoteplay
WEB2PS5_BRIDGE=fake

# First-run wizard flags (set by /setup)
WEB2PS5_SETUP_COMPLETE=false
WEB2PS5_SETUP_SKIPPED=false

# Connect on startup (fake always needs this; pyremoteplay can be false)
WEB2PS5_AUTO_CONNECT=true

# Required when WEB2PS5_BRIDGE=pyremoteplay
WEB2PS5_PS5_HOST=192.168.1.50
# Control account — macros / DualSense (defaults to first registered profile)
WEB2PS5_PS5_USER=
# Optional second PSN account (spectator / view-only role — not used for input)
WEB2PS5_PS5_SPECTATOR_USER=

WEB2PS5_PS5_RESOLUTION=720p
WEB2PS5_PS5_FPS=high
WEB2PS5_PS5_QUALITY=default
WEB2PS5_PS5_CODEC=h264

# Video: remoteplay (default, from pi2ps5) | fake | ustreamer (optional HDMI debug only)
WEB2PS5_VIDEO_SOURCE=remoteplay
WEB2PS5_VIDEO_URL=

WEB2PS5_FRAME_WIDTH=1280
WEB2PS5_FRAME_HEIGHT=720
WEB2PS5_FEEDBACK_HZ=60
WEB2PS5_MIN_PRESS_MS=80
